# GR.3g — l'ami286 de ami286-mfm.cfg, Windows réglé par son SETUP DOS pour la carte ega (c286-ega.img,
# préparé par la recette). Porte : bd-ami286-win-ega.
model = ami286
cpu = 4
mem_size = 4096
drive_a_type = 5
drive_b_type = 2
gfxcard = ega
hdd_controller = mfm_at
hdc_cylinders = 1224
hdc_heads = 15
hdc_sectors = 17
hdc_fn = @WORK@/c286-ega.img

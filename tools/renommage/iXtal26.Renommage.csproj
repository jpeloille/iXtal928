<Project Sdk="Microsoft.NET.Sdk">

    <!-- SPDX-FileCopyrightText: 2026 Julien Peloille
         SPDX-License-Identifier: GPL-2.0-only

         Le renommage sémantique (G14.0c, PLAN-G14.md décision n° 8, Q38) : Roslyn, le compilateur du SDK lui-même
         (Roslyn/bincore du SDK), sans paquet. Hors de iXtal26.sln. Les seules sources de restauration sont ce
         répertoire, qui ne contient aucun .nupkg, et /usr/lib/dotnet/library-packs, le répertoire local que le SDK
         ajoute (Microsoft.NET.NuGetOfflineCache.targets) : rien ne peut être téléchargé ; renommer.sh vérifie en plus
         que la restauration n'a tiré aucun paquet. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>iXtal26.Renommage</AssemblyName>
        <RootNamespace>iXtal26.Renommage</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
        <RoslynDuSdk>$(MSBuildBinPath)/Roslyn/bincore</RoslynDuSdk>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Microsoft.CodeAnalysis">
            <HintPath>$(RoslynDuSdk)/Microsoft.CodeAnalysis.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.CSharp">
            <HintPath>$(RoslynDuSdk)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <!-- La lecture de la table des noms, partagée avec tools/ildump. -->
        <Compile Include="../noms/TableDesNoms.cs" Link="TableDesNoms.cs"/>
    </ItemGroup>

</Project>

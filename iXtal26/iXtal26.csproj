<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>

        <!-- net10.0 = LTS jusqu'en novembre 2028. net9.0 est STS, support terminé le
             12/05/2026 : bascule maintenant plutôt que migration forcée en cours de
             transcription. -->
        <TargetFramework>net10.0</TargetFramework>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Engagement, pas préférence. Le cœur 8088 vise 4,77 MHz. La marge n'est pas
             « 50 à 100× » comme supposé avant de mesurer : 15× sur un cœur P à 4,8 GHz,
             là où le C de PCem en a 25× (VERIFICATION.md § M5). Et le bounds-check n'y
             est pour presque rien — 80 dans execx86, au même IPC que le C ; il convertit
             un biais de page mal calculé d'un bug invisible en stack trace. -->
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

        <!-- Le C enveloppe silencieusement. Explicite parce qu'un Directory.Build.props
             ou une inspection Rider peut retourner le défaut, et l'échec serait alors une
             OverflowException des milliers d'instructions après le boot. -->
        <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>

        <!-- Mesuré, pas supposé : -5 % en régime établi (VERIFICATION.md § M5.2), deux
             passes alternées de cinq répétitions. Un émulateur n'est pas une application
             de bureau — il doit tenir 100 tranches/s dès la première, pas après quelques
             centaines le temps que les paliers montent. Le tiering laissait d'ailleurs du
             Tier0 en vol jusque dans le profil (cga_poll et hline en QuickJitted).
             Coût : +164 ms au démarrage, une fois. Effet secondaire utile : la dispersion
             du banc tombe de 6-9 % à 2-3 %, donc toute mesure ultérieure est plus nette. -->
        <TieredCompilation>false</TieredCompilation>

        <!-- Plein sur le code hôte. Les fichiers transcrits portent des
             #pragma warning disable énumérés et commentés, jamais en bloc. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Bindings managés SDL3 : API idiomatique (SDL.Init, SDL.CreateWindowAndRenderer, ...). -->
        <PackageReference Include="SDL3-CS" Version="3.4.14.1"/>

        <!-- Bibliothèques natives SDL3 livrées par NuGet : rien à installer sur la machine. -->
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.14.1"/>
        <PackageReference Include="SDL3-CS.Windows" Version="3.4.14.1"/>
        <PackageReference Include="SDL3-CS.MacOS" Version="3.4.14.1"/>
    </ItemGroup>

    <!-- ============================================================
         EN COURS DE RÉCONCILIATION — exclus de la compilation.

         Ces fichiers sont des transcriptions produites en parallèle : chaque
         agent a écrit son sous-système sans voir les autres, et les points de
         contact ne concordent pas encore (noms de conteneurs, symboles attendus
         d'un module écrit par un voisin, romset/ROM_* qui appartiennent à pc.c).

         Ils sont commités parce que le travail est bon et vérifiable ligne à
         ligne contre le C ; ils sont exclus parce qu'un build rouge n'apprend
         rien. Chaque fichier réintègre la compilation dès que ses points de
         contact sont résolus — c'est la prochaine étape, pas une dette cachée.
         ============================================================ -->

    <ItemGroup>
        <!-- Les harnais lisent l'état interne du cœur. Le mapping linkage C -> accessibilité
             C# (static -> private, non-static -> internal) n'a de sens qu'en un seul
             assembly ; InternalsVisibleTo est la porte de service. -->
        <InternalsVisibleTo Include="iXtal26.Diff"/>
        <InternalsVisibleTo Include="iXtal26.Sst"/>
        <!-- iXtal26.Bench retiré : ce projet n'a jamais existé. Bench.cs a atterri
             dans tools/iXtal26.Diff, déjà couvert par la ligne ci-dessus. Une porte
             ouverte sur un assembly inexistant ne protège rien et laisse croire à un
             projet qu'on chercherait. (iXtal26.Sst est dans le même cas aujourd'hui —
             SstProbe.cs vit aussi dans iXtal26.Diff — mais le nom dit une intention,
             § M5.0 ; à trancher, pas à balayer en passant.) -->
    </ItemGroup>

</Project>

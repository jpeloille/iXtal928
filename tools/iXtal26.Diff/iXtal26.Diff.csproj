<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>iXtal26.Diff</AssemblyName>
        <RootNamespace>iXtal26.Diff</RootNamespace>

        <!-- Outillage, pas code transcrit : conventions C# normales, warnings pleins.
             Sauf le nommage des DTO SST et des imports P/Invoke, qui doivent coller
             au JSON et aux symboles C — voir .editorconfig. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

        <!-- Le MÊME réglage que iXtal26.csproj, et pour une raison de mesure, pas de
             vitesse : `bench` fait tourner le cœur DANS ce processus-ci, donc c'est ce
             runtimeconfig-ci qui gouverne son JIT. Sans cette ligne, le banc mesurerait
             un cœur étagé et le produit livrerait un cœur non étagé — deux machines
             différentes, et un ratio C#/C qui ne décrirait plus rien. -->
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>

    <ItemGroup>
        <!-- HState / R / Seg : le vecteur d'état comparé. Défini par le cœur,
             consommé ici. -->
        <ProjectReference Include="../../iXtal26/iXtal26.csproj"/>
    </ItemGroup>

</Project>

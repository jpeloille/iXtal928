# Build
bin/
obj/
*.user

# Rider / IDE
.idea/
.vs/

# ROMs — matériel IBM sous copyright, jamais commité.
# Seul le manifeste de checksums l'est, pour que la CI vérifie ce qu'elle a.
roms/*
!roms/roms.sha256

# Images de disquette et de disque dur — logiciels sous copyright (PC DOS…), même
# règle que roms/ : jamais commitées. Seul le manifeste de checksums l'est, comme
# roms/roms.sha256 : c'est lui qui ancre les mesures de VERIFICATION.md § M6.
os/*
!os/os.sha256

# Machines construites depuis l'écran de --setup, et enregistrées par config_save.
# Même règle que os/ : elles pointent des images qui ne sont pas versionnées, et leurs
# chemins n'ont de sens que sur la machine qui les a écrites. Les deux .cfg de la racine
# — ixtal26.cfg et ixtal26-xt.cfg — sont les exemples livrés, eux sont suivis.
configs/

# Vecteurs SingleStepTests — 726 Mo, récupérés par tools/fetch-sst.sh.
# Seul vectors/sst/MANIFEST.sha256 est commité.
vectors/*
!vectors/sst/
vectors/sst/*
!vectors/sst/MANIFEST.sha256
# Vecteurs SingleStepTests 80386 (G2, D0.5) — 576 Mo, récupérés par tools/fetch-sst386.sh.
!vectors/sst386/
vectors/sst386/*
!vectors/sst386/MANIFEST.sha256
# Vecteurs SingleStepTests 8086 (G13.2) — 59 Mo pour les 103 formes du manifeste, récupérés par
# tools/fetch-sst8086.sh.
!vectors/sst8086/
vectors/sst8086/*
!vectors/sst8086/MANIFEST.sha256
# Vecteurs SingleStepTests 80286 (G13.2) — 312 Mo, récupérés par tools/fetch-sst286.sh.
!vectors/sst286/
vectors/sst286/*
!vectors/sst286/MANIFEST.sha256

# Artefacts de l'oracle C
tools/oracle/*.so
tools/oracle/*.o
tools/oracle/build/

# Copie de travail patchée de pcem-dev (instrumentation de trace).
# L'arbre de référence pcem-dev/ n'est JAMAIS modifié en place.
pcem-ref-build/

# Espaces de travail et états de session des agents — jamais versionnés.
.claude/

# Brouillon de travail apparu a la racine, hors arborescence du projet.
# Non versionne : ce n'est ni du transcrit, ni de l'outillage.
/memCSharp.cs

# Le CMOS de session, ecrit par savenvr a chaque sortie. nvr/default/ est du
# contenu de reference et reste suivi.
nvr/*.nvr
nvr/.*.nvr
